<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Match the video splash's opening navy tone so the OS's mandatory
             icon splash (Android 12+, can't be removed or replaced) blends
             into the video instead of cutting from white. -->
        <item name="android:windowSplashScreenBackground">#0C1022</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.
         
         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <!-- Parent is AppCompat (not @android:style/Theme.*) because the Stripe
         Android SDK behind flutter_stripe inflates AppCompat widgets into this
         activity; with a plain framework theme the payment sheet crashes with
         "You need to use a Theme.AppCompat theme (or descendant)". Every item
         below is unchanged. LaunchTheme deliberately keeps its framework parent
         -- it is only on screen before Flutter's first frame, long before any
         payment UI, and its splash/cutout behaviour is tuned. -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- See values/styles.xml. NormalTheme is the runtime window theme, so
             the cutout mode has to be set here as well as on LaunchTheme. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
